# =============================================================================
# Python Data Pipeline - Environment Configuration Template
# Copy this file to `.env` and replace placeholder values before running locally.
# Never commit `.env` or real credential files to version control.
# =============================================================================

# Source scraping settings
BASE_URL=https://fashion-studio.dicoding.dev
MAX_PAGES=50
REQUEST_TIMEOUT=10
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=0.5

# Local CSV sink
OUTPUT_CSV_PATH=data/products.csv

# Google Sheets sink (place service account JSON inside credentials/)
GOOGLE_CREDS_PATH=credentials/google-sheets-api.json
SPREADSHEET_NAME=ETL-Submission-Project

# PostgreSQL sink (replace with real connection string in .env)
DB_URL=postgresql://placeholder_user:placeholder_password@localhost:5432/fashion_etl
DB_TABLE=fashion_products

# Structured logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
